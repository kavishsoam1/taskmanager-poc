{
  "components": [
    {
      "label": "Pre-Mobilization Requirements",
      "type": "text",
      "id": "Field_0klzmxp",
      "text": "Please submit all required pre-mobilization documentation."
    },
    {
      "label": "Project Name",
      "type": "textfield",
      "id": "Field_1klzxmp",
      "key": "projectName",
      "readonly": true
    },
    {
      "label": "Contractor Company Name",
      "type": "textfield",
      "id": "Field_0kamzxp",
      "key": "contractorName",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Contractor License Number",
      "type": "textfield",
      "id": "Field_9klzmxp_license",
      "key": "contractorLicense",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Contractor Contact Person",
      "type": "textfield",
      "id": "Field_1axqkmp",
      "key": "contractorContact",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Contractor Email",
      "type": "textfield",
      "id": "Field_0klzqmp",
      "key": "contractorEmail",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Contractor Phone",
      "type": "textfield",
      "id": "Field_1pakqmp_phone",
      "key": "contractorPhone",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Proposed Construction Start Date",
      "type": "textfield",
      "id": "Field_0kamqzp_startdate",
      "key": "constructionStartDate",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Expected Construction Duration (Days)",
      "type": "number",
      "id": "Field_9klzmxp_duration",
      "key": "constructionDuration",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Construction Method Statement",
      "type": "textfield",
      "id": "Field_0klmzqp_statement",
      "key": "methodStatement",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Risk Assessment Document",
      "type": "textfield",
      "id": "Field_1pakqmp_risk",
      "key": "riskAssessment",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Insurance Certificate",
      "type": "textfield",
      "id": "Field_0kamqzp_insurance",
      "key": "insuranceCertificate",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Worker ID List",
      "type": "textfield",
      "id": "Field_9klzmxp_workers",
      "key": "workerIdList",
      "validate": {
        "required": true
      }
    },
    {
      "label": "I confirm all submitted documentation is valid and accurate",
      "type": "checkbox",
      "id": "Field_0klmzqp_confirm",
      "key": "docConfirmation",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "pre_mobilization_form",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.12.0"
  },
  "executionPlatform": "Camunda Cloud",
