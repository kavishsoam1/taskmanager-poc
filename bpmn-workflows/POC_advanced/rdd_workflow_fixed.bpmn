<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_0fr9mxs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.1">
  <bpmn:process id="rdd_workflow" name="Retail Design &#38; Delivery Workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Process Start">
      <bpmn:outgoing>Flow_1nh9fh0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1nh9fh0" sourceRef="StartEvent_1" targetRef="Activity_LeaseFormSubmission" />
    <bpmn:userTask id="Activity_LeaseFormSubmission" name="Leasing Team Form Submission" camunda:formKey="camunda-forms:deployment:leasing_form_01.form">
      <bpmn:documentation>Leasing team completes Form-01 with tenant and space details</bpmn:documentation>
      <bpmn:incoming>Flow_1nh9fh0</bpmn:incoming>
      <bpmn:outgoing>Flow_0k3g44w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0k3g44w" sourceRef="Activity_LeaseFormSubmission" targetRef="Activity_RDDVerification" />
    <bpmn:userTask id="Activity_RDDVerification" name="RDD Team Verification" camunda:formKey="camunda-forms:deployment:rdd_verification.form">
      <bpmn:documentation>RDD team verifies form and document submissions from leasing team</bpmn:documentation>
      <bpmn:incoming>Flow_0k3g44w</bpmn:incoming>
      <bpmn:outgoing>Flow_0bcy36h</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verification" name="Is verification successful?">
      <bpmn:incoming>Flow_0bcy36h</bpmn:incoming>
      <bpmn:outgoing>Flow_1p3sht7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0gfp1uw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0bcy36h" sourceRef="Activity_RDDVerification" targetRef="Gateway_Verification" />
    <bpmn:sequenceFlow id="Flow_1p3sht7" name="Yes" sourceRef="Gateway_Verification" targetRef="Activity_ConceptDesignSubmission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verification == 'approved'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gfp1uw" name="No" sourceRef="Gateway_Verification" targetRef="Activity_LeaseFormSubmission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verification == 'rejected'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ConceptDesignSubmission" name="Tenant Concept Design Submission" camunda:formKey="camunda-forms:deployment:concept_design.form">
      <bpmn:documentation>Tenant uploads concept design documents through portal</bpmn:documentation>
      <bpmn:incoming>Flow_1p3sht7</bpmn:incoming>
      <bpmn:outgoing>Flow_0q1vbo4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0q1vbo4" sourceRef="Activity_ConceptDesignSubmission" targetRef="Activity_DesignReview" />
    <bpmn:userTask id="Activity_DesignReview" name="RDD Design Review" camunda:formKey="camunda-forms:deployment:design_review.form">
      <bpmn:documentation>RDD team reviews concept design submission</bpmn:documentation>
      <bpmn:incoming>Flow_0q1vbo4</bpmn:incoming>
      <bpmn:outgoing>Flow_1gc7li9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_WorkflowComplete" name="Process Complete">
      <bpmn:incoming>Flow_1gc7li9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1gc7li9" sourceRef="Activity_DesignReview" targetRef="Event_WorkflowComplete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="rdd_workflow">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="152" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="202" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_10czvt3_di" bpmnElement="Activity_LeaseFormSubmission">
        <dc:Bounds x="250" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1psd8p7_di" bpmnElement="Activity_RDDVerification">
        <dc:Bounds x="420" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1rk4wsf_di" bpmnElement="Gateway_Verification" isMarkerVisible="true">
        <dc:Bounds x="595" y="152" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="584" y="122" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00m7r1r_di" bpmnElement="Activity_ConceptDesignSubmission">
        <dc:Bounds x="730" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1595tz8_di" bpmnElement="Activity_DesignReview">
        <dc:Bounds x="900" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0l9s9c5_di" bpmnElement="Event_WorkflowComplete" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1072" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="202" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1nh9fh0_di" bpmnElement="Flow_1nh9fh0">
        <di:waypoint x="188" y="177" />
        <di:waypoint x="250" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0k3g44w_di" bpmnElement="Flow_0k3g44w">
        <di:waypoint x="350" y="177" />
        <di:waypoint x="420" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0bcy36h_di" bpmnElement="Flow_0bcy36h">
        <di:waypoint x="520" y="177" />
        <di:waypoint x="595" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1p3sht7_di" bpmnElement="Flow_1p3sht7">
        <di:waypoint x="645" y="177" />
        <di:waypoint x="730" y="177" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="679" y="159" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0gfp1uw_di" bpmnElement="Flow_0gfp1uw">
        <di:waypoint x="620" y="202" />
        <di:waypoint x="620" y="260" />
        <di:waypoint x="300" y="260" />
        <di:waypoint x="300" y="217" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="603" y="213" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0q1vbo4_di" bpmnElement="Flow_0q1vbo4">
        <di:waypoint x="830" y="177" />
        <di:waypoint x="900" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1gc7li9_di" bpmnElement="Flow_1gc7li9">
        <di:waypoint x="1000" y="177" />
        <di:waypoint x="1072" y="177" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
