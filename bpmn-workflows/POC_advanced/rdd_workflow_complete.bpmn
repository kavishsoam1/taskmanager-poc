<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0fr9mxs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="rdd_workflow" name="Retail Design &#38; Delivery Workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Process Start">
      <bpmn:outgoing>Flow_1nh9fh0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1nh9fh0" sourceRef="StartEvent_1" targetRef="Activity_LeaseFormSubmission" />
    <bpmn:userTask id="Activity_LeaseFormSubmission" name="Leasing Team Form Submission">
      <bpmn:documentation>Leasing team completes Form-01 with tenant and space details</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="leasing_form_01" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nh9fh0</bpmn:incoming>
      <bpmn:outgoing>Flow_0k3g44w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0k3g44w" sourceRef="Activity_LeaseFormSubmission" targetRef="Activity_RDDVerification" />
    <bpmn:userTask id="Activity_RDDVerification" name="RDD Team Verification">
      <bpmn:documentation>RDD team verifies form and document submissions from leasing team</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="rdd_verification_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k3g44w</bpmn:incoming>
      <bpmn:outgoing>Flow_0bcy36h</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verification" name="Is verification successful?">
      <bpmn:incoming>Flow_0bcy36h</bpmn:incoming>
      <bpmn:outgoing>Flow_1p3sht7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0gfp1uw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0bcy36h" sourceRef="Activity_RDDVerification" targetRef="Gateway_Verification" />
    <bpmn:sequenceFlow id="Flow_1p3sht7" name="Yes" sourceRef="Gateway_Verification" targetRef="Activity_ConceptDesignSubmission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verification = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gfp1uw" name="No" sourceRef="Gateway_Verification" targetRef="Activity_LeaseFormSubmission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verification = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ConceptDesignSubmission" name="Tenant Concept Design Submission">
      <bpmn:documentation>Tenant uploads concept design documents through portal</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="concept_design_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1p3sht7</bpmn:incoming>
      <bpmn:outgoing>Flow_0q1vbo4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0q1vbo4" sourceRef="Activity_ConceptDesignSubmission" targetRef="Activity_DesignReview" />
    <bpmn:userTask id="Activity_DesignReview" name="RDD Design Review">
      <bpmn:documentation>RDD team reviews concept design submission</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="design_review_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0q1vbo4</bpmn:incoming>
      <bpmn:outgoing>Flow_1cvht1a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DesignApproval" name="Is design approved?">
      <bpmn:incoming>Flow_1cvht1a</bpmn:incoming>
      <bpmn:outgoing>Flow_0urn89t</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ubfm1d</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1cvht1a" sourceRef="Activity_DesignReview" targetRef="Gateway_DesignApproval" />
    <bpmn:sequenceFlow id="Flow_0urn89t" name="No" sourceRef="Gateway_DesignApproval" targetRef="Activity_ConceptDesignSubmission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=designApproval = "rejected" or designApproval = "revisionsRequired"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ubfm1d" name="Yes" sourceRef="Gateway_DesignApproval" targetRef="Activity_PreMobilization">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=designApproval = "approved" or designApproval = "approvedWithComments"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_PreMobilization" name="Pre-Mobilization Documentation">
      <bpmn:documentation>Tenant submits pre-mobilization requirements (insurance, contractor details)</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="pre_mobilization_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ubfm1d</bpmn:incoming>
      <bpmn:outgoing>Flow_02rfev4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_02rfev4" sourceRef="Activity_PreMobilization" targetRef="Activity_PreMobilizationReview" />
    <bpmn:userTask id="Activity_PreMobilizationReview" name="RDD Pre-Mobilization Review">
      <bpmn:documentation>RDD team reviews pre-mobilization documents</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="pre_mobilization_review_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02rfev4</bpmn:incoming>
      <bpmn:outgoing>Flow_1b0wjp8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PreMobApproval" name="Is pre-mobilization approved?">
      <bpmn:incoming>Flow_1b0wjp8</bpmn:incoming>
      <bpmn:outgoing>Flow_1mt4rlm</bpmn:outgoing>
      <bpmn:outgoing>Flow_1f8vzdr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1b0wjp8" sourceRef="Activity_PreMobilizationReview" targetRef="Gateway_PreMobApproval" />
    <bpmn:sequenceFlow id="Flow_1mt4rlm" name="No" sourceRef="Gateway_PreMobApproval" targetRef="Activity_PreMobilization">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=preMobilizationApproval = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1f8vzdr" name="Yes" sourceRef="Gateway_PreMobApproval" targetRef="Activity_SiteMobilization">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=preMobilizationApproval = "approved" or preMobilizationApproval = "conditional"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_SiteMobilization" name="Site Mobilization">
      <bpmn:documentation>Tenant starts site mobilization and construction</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="site_mobilization_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1f8vzdr</bpmn:incoming>
      <bpmn:outgoing>Flow_0oe3k1j</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0oe3k1j" sourceRef="Activity_SiteMobilization" targetRef="Activity_InspectionRequest" />
    <bpmn:userTask id="Activity_InspectionRequest" name="Inspection Request">
      <bpmn:documentation>Tenant requests pre-ceiling closure inspection</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="inspection_request_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oe3k1j</bpmn:incoming>
      <bpmn:outgoing>Flow_1bzyzde</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1bzyzde" sourceRef="Activity_InspectionRequest" targetRef="Activity_InspectionPerformance" />
    <bpmn:userTask id="Activity_InspectionPerformance" name="Inspection Performance">
      <bpmn:documentation>RDD team performs inspection and records findings</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="inspection_performance_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bzyzde</bpmn:incoming>
      <bpmn:outgoing>Flow_1bxd7fa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InspectionApproval" name="Is inspection approved?">
      <bpmn:incoming>Flow_1bxd7fa</bpmn:incoming>
      <bpmn:outgoing>Flow_18onkbl</bpmn:outgoing>
      <bpmn:outgoing>Flow_0cl3ugy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1bxd7fa" sourceRef="Activity_InspectionPerformance" targetRef="Gateway_InspectionApproval" />
    <bpmn:sequenceFlow id="Flow_18onkbl" name="No" sourceRef="Gateway_InspectionApproval" targetRef="Activity_InspectionRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inspectionApproval = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0cl3ugy" name="Yes" sourceRef="Gateway_InspectionApproval" targetRef="Activity_FinalInspectionRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inspectionApproval = "approved" or inspectionApproval = "conditional"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_FinalInspectionRequest" name="Final Inspection Request">
      <bpmn:documentation>Tenant requests final inspection</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="final_inspection_request_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cl3ugy</bpmn:incoming>
      <bpmn:outgoing>Flow_1rhdvs4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1rhdvs4" sourceRef="Activity_FinalInspectionRequest" targetRef="Activity_FinalInspection" />
    <bpmn:userTask id="Activity_FinalInspection" name="Final Inspection Performance">
      <bpmn:documentation>RDD team performs final inspection</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="final_inspection_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1rhdvs4</bpmn:incoming>
      <bpmn:outgoing>Flow_1o0d290</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalApproval" name="Is final inspection approved?">
      <bpmn:incoming>Flow_1o0d290</bpmn:incoming>
      <bpmn:outgoing>Flow_1r0p2q0</bpmn:outgoing>
      <bpmn:outgoing>Flow_18yrtcf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1o0d290" sourceRef="Activity_FinalInspection" targetRef="Gateway_FinalApproval" />
    <bpmn:sequenceFlow id="Flow_1r0p2q0" name="No" sourceRef="Gateway_FinalApproval" targetRef="Activity_FinalInspectionRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalApproval = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18yrtcf" name="Yes" sourceRef="Gateway_FinalApproval" targetRef="Activity_PermissionToTrade">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalApproval = "approved" or finalApproval = "conditional"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_PermissionToTrade" name="Permission to Trade">
      <bpmn:documentation>RDD issues Permission to Trade document</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="permission_to_trade_form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18yrtcf</bpmn:incoming>
      <bpmn:outgoing>Flow_13uk7za</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_WorkflowComplete" name="Process Complete">
      <bpmn:incoming>Flow_13uk7za</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13uk7za" sourceRef="Activity_PermissionToTrade" targetRef="Event_WorkflowComplete" />
  </bpmn:process>
