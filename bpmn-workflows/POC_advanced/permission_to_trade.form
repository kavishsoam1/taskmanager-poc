{
  "components": [
    {
      "label": "Permission to Trade Issuance",
      "type": "text",
      "id": "Field_0klzmxp",
      "text": "Please complete this form to issue the Permission to Trade certificate."
    },
    {
      "label": "Project Name",
      "type": "textfield",
      "id": "Field_1klzxmp",
      "key": "projectName",
      "readonly": true
    },
    {
      "label": "Tenant Name",
      "type": "textfield",
      "id": "Field_0kamzxp",
      "key": "tenantName",
      "readonly": true
    },
    {
      "label": "Space Reference",
      "type": "textfield",
      "id": "Field_9klzmxp",
      "key": "spaceReference",
      "readonly": true
    },
    {
      "label": "Final Inspection Date",
      "type": "textfield",
      "id": "Field_1axqkmp",
      "key": "finalInspectionDate",
      "readonly": true
    },
    {
      "label": "Certificate Number",
      "type": "textfield",
      "id": "Field_0klzqmp",
      "key": "certificateNumber",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Permission to Trade Valid From",
      "type": "textfield",
      "id": "Field_1pakqmp",
      "key": "validFromDate",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Conditions",
      "type": "select",
      "id": "Field_0kamqzp",
      "key": "conditions",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "No Conditions - Full Permission",
          "value": "noConditions"
        },
        {
          "label": "Temporary Permission - With Conditions",
          "value": "temporary"
        }
      ]
    },
    {
      "label": "Specific Conditions (if applicable)",
      "type": "textarea",
      "id": "Field_9klzmxp_1",
      "key": "specificConditions",
      "conditional": {
        "hide": "=conditions != \"temporary\""
      }
    },
    {
      "label": "Outstanding Items",
      "type": "textfield",
      "id": "Field_0klmzqp_2",
      "key": "outstandingItems",
      "values": [
        {
          "label": "Minor Finishes",
          "value": "minorFinishes"
        },
        {
          "label": "Documentation Submission",
          "value": "documentation"
        },
        {
          "label": "Signage Completion",
          "value": "signage"
        },
        {
          "label": "MEP Final Certificates",
          "value": "mepCertificates"
        },
        {
          "label": "None - All Complete",
          "value": "none"
        }
      ]
    },
    {
      "label": "Deadline for Outstanding Items",
      "type": "textfield",
      "id": "Field_1pakqmp_2",
      "key": "outstandingDeadline",
      "conditional": {
        "hide": "=outstandingItems.includes(\"none\")"
      }
    },
    {
      "label": "Mall Operations Notified",
      "type": "checkbox",
      "id": "Field_0kamqzp_1",
      "key": "operationsNotified",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Security Access Arranged",
      "type": "checkbox",
      "id": "Field_9klzmxp_2",
      "key": "securityAccess",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Approving Authority",
      "type": "textfield",
      "id": "Field_0klmzqp_1",
      "key": "approvingAuthority",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Authorization Date",
      "type": "textfield",
      "id": "Field_1pakqmp_1",
      "key": "authorizationDate",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Authorizer Signature",
      "type": "textfield",
      "id": "Field_0kamqzp_2",
      "key": "authorizerSignature",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Generate Certificate",
      "type": "button",
      "id": "Field_9klzmxp_3",
      "key": "generateCertificate"
    }
  ],
  "type": "default",
  "id": "permission_to_trade_form",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.12.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.7.0",
  "schemaVersion": 8
}