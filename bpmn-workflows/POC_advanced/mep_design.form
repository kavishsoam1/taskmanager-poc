{
  "components": [
    {
      "label": "MEP Design Submission",
      "type": "text",
      "id": "Field_0klzmxa",
      "text": "Please complete the MEP (Mechanical, Electrical, Plumbing) design submission form."
    },
    {
      "label": "Project Name",
      "type": "textfield",
      "id": "Field_1klzxme",
      "key": "projectName",
      "readonly": true
    },
    {
      "label": "Electrical Load Requirements (KW)",
      "type": "number",
      "id": "Field_0kamzxe",
      "key": "electricalLoad",
      "validate": {
        "required": true
      }
    },
    {
      "label": "HVAC Requirements",
      "type": "textarea",
      "id": "Field_9klzmxt",
      "key": "hvacRequirements",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Water Supply Requirements",
      "type": "textarea",
      "id": "Field_1axqkme",
      "key": "waterRequirements"
    },
    {
      "label": "Drainage Requirements",
      "type": "textarea",
      "id": "Field_0klzqma",
      "key": "drainageRequirements"
    },
    {
      "label": "Special Requirements",
      "type": "textarea",
      "id": "Field_1pakqme",
      "key": "specialRequirements"
    },
    {
      "label": "Electrical Single Line Diagram (File Path or URL)",
      "type": "textfield",
      "id": "Field_0kamqze",
      "key": "electricalDiagram",
      "validate": {
        "required": true
      }
    },
    {
      "label": "HVAC Layout Plan (File Path or URL)",
      "type": "textfield",
      "id": "Field_9klzmxe",
      "key": "hvacLayout",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Plumbing Layout Plan (File Path or URL)",
      "type": "textfield",
      "id": "Field_0klmzqa",
      "key": "plumbingLayout"
    },
    {
      "label": "Fire & Safety Systems Layout (File Path or URL)",
      "type": "textfield",
      "id": "Field_1pakqma",
      "key": "fireSystemLayout",
      "validate": {
        "required": true
      }
    },
    {
      "label": "MEP Consultant Details",
      "type": "textfield",
      "id": "Field_0kamqza",
      "key": "mepConsultant",
      "validate": {
        "required": true
      }
    },
    {
      "label": "I confirm all MEP designs comply with building codes and mall technical guidelines",
      "type": "checkbox",
      "id": "Field_9klzmxa",
      "key": "mepComplianceConfirmation",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "mep_design_form",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.12.0"
  },
